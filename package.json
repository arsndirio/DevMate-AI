{
    "name": "devmate-ai",
    "version": "0.1.0",
    "private": true,
    "description": "AI coding assistant berbasis Google Gemini untuk analisis error, review kode, dan solusi teknis.",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint src --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@google/genai": "^2.30.0",
        "next": "^16.4.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "react-syntax-highlighter": "^16.1.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/core": "^8.0.7",
        "@babel/eslint-parser": "^8.0.7",
        "@babel/preset-env": "^8.0.7",
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.7",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-syntax-highlighter": "^15.5.13",
        "@vitejs/plugin-react": "^4.5.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^9.0.0",
        "jsdom": "^30.1.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    }
